APP_NAME="Gravity AI CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://zoortech.tj
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
VITE_APP_NAME="Gravity AI CRM"

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_DATABASE=ai_crm
DB_USERNAME=crm
DB_PASSWORD=change-me-crm-password
DB_ROOT_PASSWORD=change-me-root-password

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database

CHATWOOT_URL=https://chatwoot.zoortech.tj
CHATWOOT_ACCOUNT_ID=
CHATWOOT_API_TOKEN=
CHATWOOT_WEBHOOK_SECRET=

DIFY_API_URL=https://dify.zoortech.tj/v1
DIFY_API_KEY=
DIFY_TIMEOUT=12

ACME_EMAIL=admin@zoortech.tj
CHATWOOT_UPSTREAM=host.docker.internal:3000
DIFY_UPSTREAM=host.docker.internal:8080
RUN_MIGRATIONS=true
RUN_SEEDERS=false