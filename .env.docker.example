# Copy to .env before running `docker compose up` — used both to fill the
# app container's own .env (via env_file:) and by docker compose itself to
# interpolate ${DB_DATABASE} etc. into docker-compose.yml. DB_HOST/REDIS_HOST/
# QUEUE_CONNECTION/CACHE_STORE/REVERB_HOST are hardcoded to the compose
# service names directly in docker-compose.yml and don't need to be repeated
# here.

APP_NAME="WERO"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en

VITE_APP_NAME="${APP_NAME}"

DB_DATABASE=ai_crm
DB_USERNAME=ai_crm
DB_PASSWORD=change-me

SESSION_DRIVER=database
BROADCAST_CONNECTION=reverb

MAIL_MAILER=log

REVERB_APP_ID=local
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"

TELEGRAM_MODERATOR_BOT_TOKEN=
TELEGRAM_MODERATOR_CHAT_ID=

DIFY_API_URL=
DIFY_API_KEY=

# --- docker compose only (not read by Laravel itself) ---
APP_PORT=8000
REVERB_PORT=6001
RUN_MIGRATIONS=true
RUN_SEEDERS=false
CACHE_CONFIG=false
